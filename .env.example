# crypto-strategy-lab environment configuration
# Copy to `.env` and adjust if needed.
#
# IMPORTANT: The Bitunix public market API needs NO credentials for this
# research milestone. Do NOT put API keys / trading secrets in this file.

# Bitunix public spot API:
# - kline/history: paginated deep history (limit <= 500, endTime in unix
#   SECONDS) - this is what downloads use.
# - kline: latest ~201 candles snapshot (utility only, not history).
BITUNIX_SPOT_BASE_URL=https://openapi.bitunix.com

# Bitunix futures public API (paginated via `endTime` in ms, <= 200 rows per
# page, deep OHLCV history from 2022-04).
BITUNIX_FUTURES_BASE_URL=https://fapi.bitunix.com

# Where datasets / reports live (relative to project root or absolute path).
CSL_DATA_DIR=data
CSL_REPORTS_DIR=reports

# Log level: DEBUG | INFO | WARNING | ERROR
CSL_LOG_LEVEL=INFO
